# ---------------------------------------------------------------------------
# Lectio environment variables. Copy to .env.local for local development.
# Values marked [secret] must never be exposed to the browser: only variables
# prefixed with NEXT_PUBLIC_ end up in client bundles.
# ---------------------------------------------------------------------------

# Supabase project (Settings > API). Locally: printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable / anon key (safe in the browser, RLS protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [secret] Service role / secret key: server routes, cron, seed scripts only
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the app (used for auth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Comma-separated emails allowed to open /admin
ADMIN_EMAILS=you@example.com

# [secret] Anthropic API key: card generation only (npm run seed:cards), never in the app
ANTHROPIC_API_KEY=
# Models of the generation pipeline (Message Batches, half price)
LECTIO_WRITER_MODEL=claude-sonnet-5-5
LECTIO_CHECKER_MODEL=claude-sonnet-5-5
# Spending cap of one seed:cards run, in US dollars (checked before each batch)
MAX_BUDGET_USD=10

# [secret] Shared secret between the pipeline and the `embed` Edge Function.
# Set the same value on Supabase: npx supabase secrets set EMBEDDING_FUNCTION_SECRET=...
EMBEDDING_FUNCTION_SECRET=
# Optional override (defaults to $NEXT_PUBLIC_SUPABASE_URL/functions/v1/embed)
EMBEDDING_FUNCTION_URL=

# Optional: local fast voice server (Kokoro). Start it with `npm run tts:kokoro`
# (setup once: `npm run tts:kokoro:setup`). When reachable, its voices are offered and used by default.
KOKORO_URL=

