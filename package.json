{
  "name": "lectio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/database.ts",
    "db:types:remote": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > types/database.ts",
    "test:db": "vitest run --config vitest.integration.config.mts",
    "tts:kokoro": "cd tts-server && ./venv/bin/python kokoro_server.py",
    "tts:kokoro:setup": "cd tts-server && python3 -m venv venv && ./venv/bin/pip install -r requirements.txt",
    "setup": "node scripts/setup.mjs",
    "import:bible": "tsx scripts/import-bible.ts",
    "import:sources": "tsx scripts/import-sources.ts",
    "seed:cards": "tsx scripts/seed-cards.ts",
    "check:db": "tsx scripts/check-db.ts",
    "export:cards": "tsx scripts/export-cards.ts",
    "review:import": "tsx scripts/import-review.ts",
    "seed:content": "tsx scripts/seed-content.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "edge-tts-universal": "^1.4.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20.9"
  }
}
